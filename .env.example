# Copy to .env for local data fetching (never commit .env).
# In GitHub these live in Settings -> Secrets and variables -> Actions.

# Twitch app (dev.twitch.tv/console, "Confidential" client). Enables schedule/VODs/clips via Helix.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: X API pay-per-use "owned reads" (OAuth 1.0a keys of an app owned by @MasstarVT).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional: YouTube Data API key (only used if the channel RSS feed fails).
YOUTUBE_API_KEY=

# Optional: where to read the previously deployed data from when a source fails.
# PREVIOUS_DATA_URL=https://blog.masstar.org/data
