---
import Reveal from './Reveal.astro'
import GlowPanel from './GlowPanel.astro'
import TextReveal from './TextReveal.astro'

interface Props {
  id: string
  title: string
  subtitle?: string
  action?: { href: string; label: string; external?: boolean }
  delay?: number
  class?: string
}
const { id, title, subtitle, action, delay = 0, class: className } = Astro.props
---
<Reveal delay={delay} class={className}>
  <GlowPanel as="section" class="hub-panel" id={id} aria-labelledby={`${id}-title`}>
    <div class="section-heading hub-heading">
      <div>
        <h2 class="category-title" id={`${id}-title`}><TextReveal text={title} /></h2>
        {subtitle && <p class="category-subtitle">{subtitle}</p>}
      </div>
      {action && (
        <a
          class="panel-action"
          href={action.href}
          target={action.external ? '_blank' : undefined}
          rel={action.external ? 'noopener noreferrer' : undefined}
        >{action.label} {action.external ? '↗' : '→'}</a>
      )}
    </div>
    <slot />
  </GlowPanel>
</Reveal>
