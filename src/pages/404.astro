---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Page not found" noindex>
  <div class="not-found">
    <div class="not-found-inner">
      <div class="not-found-code" aria-hidden="true">
        <span class="nf-digit" data-text="4">4</span>
        <span class="nf-digit nf-zero" data-text="0">0</span>
        <span class="nf-digit" data-text="4">4</span>
      </div>
      <div class="not-found-content reveal is-in">
        <h1 class="nf-heading">Lost in the void</h1>
        <p class="nf-sub">That page doesn't exist — it may have moved, or never existed at all.</p>
        <a href="/" class="nf-home-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path>
          </svg>
          Back to home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
