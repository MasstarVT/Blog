---
import { ClientRouter } from 'astro:transitions'
import { site } from '../config/site.mjs'
import { getLiveSnapshot } from '../lib/data.js'
import IntroGate from '../components/react/IntroGate.jsx'
import Nav from '../components/react/Nav.jsx'
import CursorGlow from '../components/react/CursorGlow.jsx'
import Particles from '../components/react/Particles.jsx'
import ScrollProgress from '../components/react/ScrollProgress.jsx'
import Background from '../components/astro/Background.astro'
import Footer from '../components/astro/Footer.astro'
import '../styles/website.css'
import '../styles/blog.css'

interface Props {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  tags?: string[]
  noindex?: boolean
}

const {
  title,
  description = site.description,
  image = '/og-default.jpg',
  imageAlt = `${site.name} banner`,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props

const pageTitle = title ? `${title} · ${site.name}` : site.title
const canonical = new URL(Astro.url.pathname, Astro.site)
const imageUrl = new URL(image, Astro.site)
const live = getLiveSnapshot()

// Page transition matching the Website's route animation (enter y 18→0 .38s, exit y→-10 .22s)
const pageAnim = {
  forwards: {
    old: { name: 'pageOut', duration: '0.22s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'pageIn', duration: '0.38s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'pageOut', duration: '0.22s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'pageIn', duration: '0.38s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' },
  },
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/PFP.jpg" />
    <link rel="apple-touch-icon" href="/PFP.jpg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${site.x.handle}`} />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <!-- Runs before first paint: JS flag + decide whether this visit gets the intro -->
    <script is:inline define:vars={{ introEnabled: site.intro.enabled }}>
      (() => {
        const root = document.documentElement
        root.classList.add('js')
        if (!window.__masstarBoot) {
          window.__masstarBoot = true
          // ClientRouter replaces <html> attributes on navigation; restore the flags (scripts are clearly running)
          document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js', 'reveal-ready', 'hydrated'))
          try {
            const seen = sessionStorage.getItem('masstar:intro')
            const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
            if (introEnabled && !seen && !reduce && location.pathname === '/') {
              root.dataset.intro = 'pending'
              // Matches the CSS shield failsafe: if the intro hasn't started within 4s, skip it for good
              setTimeout(() => {
                if (root.dataset.intro === 'pending') {
                  delete root.dataset.intro
                  sessionStorage.setItem('masstar:intro', '1')
                }
              }, 4000)
            } else sessionStorage.setItem('masstar:intro', '1')
          } catch {}
        }
      })()
    </script>
    <noscript>
      <style>
        .reveal, .tr-word { opacity: 1 !important; transform: none !important; filter: none !important; }
        [style*="opacity:0"] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="intro-shield" aria-hidden="true"></div>
    <div id="root">
      <IntroGate client:only="react" />
      <ScrollProgress client:idle transition:persist="scroll-progress" />
      <CursorGlow client:media="(hover: hover) and (pointer: fine)" transition:persist="cursor-glow" />
      <Particles client:media="(min-width: 769px)" transition:persist="particles" />
      <Background />
      <div class="container">
        <Nav client:load transition:persist="nav" pathname={Astro.url.pathname} live={live} />
        <main id="main" class="page" transition:animate={pageAnim}>
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script>
      import '../scripts/reveal.js'
      import '../scripts/glow-panel.js'
      import '../scripts/local-time.js'
      import '../scripts/embed-facade.js'
      import '../scripts/x-embed.js'
      import '../scripts/social-refresh.js'
      import '../scripts/schedule-refresh.js'
    </script>
  </body>
</html>
