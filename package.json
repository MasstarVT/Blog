{
  "name": "masstarvt-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/fetch-data.mjs --if-missing",
    "dev": "astro dev --port 4321",
    "fetch": "node --env-file-if-exists=.env scripts/fetch-data.mjs",
    "prebuild": "node --env-file-if-exists=.env scripts/fetch-data.mjs --if-missing",
    "build": "astro build",
    "preview": "astro preview --port 4322",
    "check": "astro check",
    "test": "node --test \"scripts/test/**/*.test.mjs\"",
    "test:dist": "node --test \"scripts/test-dist/*.test.mjs\"",
    "new": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "motion": "14.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
